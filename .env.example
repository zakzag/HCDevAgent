# =============================================================================
# HCDevAgent – Environment Configuration Template
# Copy to .env and fill in your real values.
# =============================================================================

# ─── Jira Cloud ──────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=HC

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_replace_with_your_github_token
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# ─── Git identity (used when creating commits) ───────────────────────────────
GIT_USER_NAME=HCDevAgent
GIT_USER_EMAIL=hcdevagent@your-domain.com

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Format: mongodb://USER:PASSWORD@HOST:PORT/DB?authSource=admin
MONGODB_URI=mongodb://agentuser:agentpassword@localhost:27017/hcdevagent?authSource=admin
MONGODB_DB_NAME=hcdevagent

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Choose: "openai" | "copilot"
AI_PROVIDER=openai

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o

# GitHub Models — used when AI_PROVIDER=copilot (reuses GITHUB_TOKEN, needs `models:read` scope)
# NOTE: api.githubcopilot.com does NOT accept PATs; use models.inference.ai.azure.com instead.
COPILOT_API_URL=https://models.inference.ai.azure.com
COPILOT_MODEL=gpt-4o

# ─── Agent Runtime ───────────────────────────────────────────────────────────
# Log level: fatal | error | warn | info | debug | trace
AGENT_LOG_LEVEL=debug
AGENT_POLL_INTERVAL_MS=30000

